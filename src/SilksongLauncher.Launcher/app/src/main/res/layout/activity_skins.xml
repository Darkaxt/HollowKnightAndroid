<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/skins_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/skins_availability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/skins_binding_unavailable"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/skins_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/skins_loading"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
        <Button
            android:id="@+id/skins_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/skins_refresh" />
        <Button
            android:id="@+id/skins_advance_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="@string/skins_advance_mode" />
        <Button
            android:id="@+id/skins_prepare_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="@string/skins_prepare_file" />
        <Button
            android:id="@+id/skins_prepare_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="@string/skins_prepare_folder" />
        <TextView
            android:id="@+id/skins_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
        <LinearLayout
            android:id="@+id/skins_prepared"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Button
            android:id="@+id/skins_import_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:enabled="false"
            android:text="@string/skins_import_all" />
        <Button
            android:id="@+id/skins_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:enabled="false"
            android:text="@string/skins_cancel" />
        <LinearLayout
            android:id="@+id/skins_packs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Button
            android:id="@+id/skins_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/settings_back" />
    </LinearLayout>
</ScrollView>
