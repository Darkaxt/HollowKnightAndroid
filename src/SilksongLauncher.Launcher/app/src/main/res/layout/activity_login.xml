<?xml version="1.0" encoding="utf-8"?>
<!--
  Sign-in screen. Sized for the Ayn Thor's effective landscape area, which is
  only ~420dp tall, so everything here is tight on purpose.

  Two columns, and both are a way in: the QR on the left for anyone with the
  Steam mobile app, the form on the right for everyone else. They are shown
  together rather than behind a toggle because an account guarded by an emailed
  code cannot use the QR at all, and discovering that by scanning and waiting
  is a poor way to find out.

  The Steam Guard row starts gone and is revealed only when Steam asks, since
  most of the time it never does.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@color/surface"
    android:gravity="center_vertical">

    <!-- Left: QR code. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:background="@color/text_primary">

            <ImageView
                android:id="@+id/img_qr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/login_subtitle" />

            <ProgressBar
                android:id="@+id/login_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Right: the form. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_password_hint"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/edit_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/login_username"
            android:autofillHints="username"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionNext"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:textSize="14sp"
            android:minHeight="0dp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/login_password"
            android:autofillHints="password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:textSize="14sp"
            android:minHeight="0dp"
            android:layout_marginBottom="8dp" />

        <!-- Steam Guard. Revealed only when Steam asks for a code. -->
        <LinearLayout
            android:id="@+id/row_guard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/edit_guard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/login_guard_hint"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btn_guard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_guard_submit"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_sign_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_sign_in"
                android:textSize="14sp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_cancel"
                android:textSize="14sp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:minHeight="0dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_status_connecting"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginTop="10dp" />
    </LinearLayout>

</LinearLayout>
