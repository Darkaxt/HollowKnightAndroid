<?xml version="1.0" encoding="utf-8"?>
<!--
  Sized for the Ayn Thor's effective landscape area (~832dp x 420dp after
  status/nav bars). Left = the menu, right = the log.

  Launch sits at the bottom of the left column, separated from the rest by the
  space between them: it is the thing this screen exists for, and everything
  above it is housekeeping. It is the only white button, which is what makes it
  findable on a red page without reading.

  Download and upload share a row. They are two halves of one idea, they are
  the only actions here that can be waiting on a network, and pairing them
  buys the height that the rest of the buttons spend on padding.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/launch_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- ── Left: the menu ──────────────────────────────────── -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.58"
                android:orientation="vertical"
                android:paddingEnd="14dp">

                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_log_in"
                    android:textSize="16sp"
                    android:textColor="@color/text_on_control"
                    android:backgroundTint="@color/surface_control"
                    android:foreground="@drawable/focus_on_light"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:minHeight="0dp"
                    android:layout_marginBottom="10dp" />

                <!-- Download / upload, paired. The spinner replaces the arrow
                     while the operation runs; the button keeps its label. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp">

                        <Button
                            android:id="@+id/btn_pull"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_pull_saves"
                            android:textSize="16sp"
                            android:textColor="@color/text_on_control"
                            android:backgroundTint="@color/surface_control"
                            android:foreground="@drawable/focus_on_light"
                            android:paddingTop="18dp"
                            android:paddingBottom="18dp"
                            android:minHeight="0dp"
                            android:enabled="false" />

                        <ProgressBar
                            android:id="@+id/spin_pull"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="16dp"
                            android:indeterminateTint="@color/text_on_control"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/btn_push"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_push_saves"
                            android:textSize="16sp"
                            android:textColor="@color/text_on_control"
                            android:backgroundTint="@color/surface_control"
                            android:foreground="@drawable/focus_on_light"
                            android:paddingTop="18dp"
                            android:paddingBottom="18dp"
                            android:minHeight="0dp"
                            android:enabled="false" />

                        <ProgressBar
                            android:id="@+id/spin_push"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="16dp"
                            android:indeterminateTint="@color/text_on_control"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Mods beside Settings rather than inside it: a mod is
                     installed by dropping a file in a folder, so the screen
                     that says whether that worked is the one somebody comes
                     back to. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_mods"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:text="@string/action_mods"
                        android:textSize="16sp"
                        android:textColor="@color/text_on_control"
                        android:backgroundTint="@color/surface_control"
                        android:foreground="@drawable/focus_on_light"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp"
                        android:minHeight="0dp" />

                    <Button
                        android:id="@+id/btn_settings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_settings"
                        android:textSize="16sp"
                        android:textColor="@color/text_on_control"
                        android:backgroundTint="@color/surface_control"
                        android:foreground="@drawable/focus_on_light"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp"
                        android:minHeight="0dp" />
                </LinearLayout>

                <!-- Quiet, because it is for the rare day something has gone
                     wrong and somebody has asked for the log. -->
                <Button
                    android:id="@+id/btn_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_logs"
                    android:textSize="13sp"
                    android:textColor="@color/text_dim"
                    android:backgroundTint="@android:color/transparent"
                    android:foreground="@drawable/focus_on_dark"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:minHeight="0dp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!--
                  focusedByDefault, so a controller lands here rather than on
                  whatever happens to be first in the tree. Declarative on
                  purpose: requestFocus() from code is what put this activity
                  into non-touch mode and cost every button a second press.
                -->
                <Button
                    android:id="@+id/btn_launch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_launch"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/hornet_red"
                    android:foreground="@drawable/focus_on_dark"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:minHeight="0dp"
                    android:focusedByDefault="true" />
            </LinearLayout>

            <!-- ── Right: the log ──────────────────────────────────── -->
            <!--
              Nothing here takes focus. A ScrollView is focusable by default so
              that a D-pad can scroll it, and textIsSelectable quietly makes a
              TextView focusable too, so on a handheld the first stick movement
              landed in the log and stayed there: the buttons could not be
              reached at all. The log is a status feed, not a control, and
              selecting text in it belongs to the Logs screen, which does it
              properly with Share and Copy.

              blocksDescendants rather than focusable="false" alone, because
              that only excuses the ScrollView itself and the TextView inside it
              was the other half of the problem.
            -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.42"
                android:background="@color/surface_panel"
                android:padding="8dp">

                <ScrollView
                    android:id="@+id/log_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="vertical"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:descendantFocusability="blocksDescendants">

                    <TextView
                        android:id="@+id/txt_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/launcher_status_idle"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:focusable="false" />
                </ScrollView>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
