<?xml version="1.0" encoding="utf-8"?>
<!--
  Sized for the Ayn Thor's effective landscape area (~832dp x 420dp after
  status/nav bars).

  Games on top, then two labelled sections (Steam: account and cloud saves;
  Game: plugins, skins, settings, logs), one status line, and PLAY. PLAY is
  the only red control; everything else uses the dark secondary style. The
  live log is not here: it is mirrored on the lower display while this screen
  is open (LowerDisplayLog) and stays complete behind View logs.

  Game cards carry their status chip only. Pinning a home-screen shortcut is
  a long-press on the card.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/launch_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_runtime_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@color/surface_panel"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/runtime_test_banner"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/game_selector"
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <dev.silksong.launcher.GameCardView
                android:id="@+id/radio_hollow_knight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true"
                android:longClickable="true"
                android:foreground="@drawable/game_card_outline">

                <ImageView
                    android:id="@+id/img_hollow_knight_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/game_card_hollow_knight_hero" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/game_card_scrim"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/img_hollow_knight_logo"
                    android:layout_width="210dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/game_card_hollow_knight_logo" />

                <TextView
                    android:id="@+id/txt_hollow_knight_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/game_card_status"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </dev.silksong.launcher.GameCardView>

            <dev.silksong.launcher.GameCardView
                android:id="@+id/radio_silksong"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:clickable="true"
                android:focusable="true"
                android:longClickable="true"
                android:nextFocusDown="@id/btn_mods"
                android:foreground="@drawable/game_card_outline">

                <ImageView
                    android:id="@+id/img_silksong_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/game_card_silksong_hero" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/game_card_scrim"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/img_silksong_logo"
                    android:layout_width="210dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/game_card_silksong_logo" />

                <TextView
                    android:id="@+id/txt_silksong_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/game_card_status"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </dev.silksong.launcher.GameCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- ── Steam: account and cloud saves ─────────────────────── -->
            <LinearLayout
                android:id="@+id/section_steam"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:orientation="vertical">

                <TextView
                    style="@style/DualSouls.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_section_steam" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_login_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:maxLines="2"
                        android:text="@string/home_steam_signed_out"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_login"
                        style="@style/DualSouls.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="96dp"
                        android:nextFocusRight="@id/btn_mods"
                        android:text="@string/action_log_in" />
                </LinearLayout>

                <!-- The spinner replaces nothing: it sits at the start of the
                     button while that transfer runs. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_pull"
                        style="@style/DualSouls.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:nextFocusRight="@id/btn_settings"
                        android:text="@string/action_pull_saves" />

                    <ProgressBar
                        android:id="@+id/spin_pull"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="14dp"
                        android:indeterminateTint="@color/text_primary"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_push"
                        style="@style/DualSouls.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:nextFocusDown="@id/btn_launch"
                        android:nextFocusRight="@id/btn_logs"
                        android:text="@string/action_push_saves" />

                    <ProgressBar
                        android:id="@+id/spin_push"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="14dp"
                        android:indeterminateTint="@color/text_primary"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- ── Game: what is built into the selected game ──────────── -->
            <LinearLayout
                android:id="@+id/section_game"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:orientation="vertical">

                <TextView
                    style="@style/DualSouls.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_section_game" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_mods"
                        style="@style/DualSouls.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:nextFocusLeft="@id/btn_login"
                        android:nextFocusDown="@id/btn_settings"
                        android:text="@string/action_plugins" />

                    <Button
                        android:id="@+id/btn_skins"
                        style="@style/DualSouls.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:nextFocusDown="@id/btn_logs"
                        android:text="@string/action_skins" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_settings"
                        style="@style/DualSouls.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:nextFocusDown="@id/btn_launch"
                        android:text="@string/action_settings" />

                    <Button
                        android:id="@+id/btn_logs"
                        style="@style/DualSouls.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:nextFocusDown="@id/btn_launch"
                        android:text="@string/action_logs" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Version, cloud state and the last thing that happened. The full
             story is on the lower display and behind View logs. -->
        <TextView
            android:id="@+id/txt_status_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <!--
          focusedByDefault, so a controller lands here rather than on
          whatever happens to be first in the tree. Declarative on
          purpose: requestFocus() from code is what put this activity
          into non-touch mode and cost every button a second press.
        -->
        <Button
            android:id="@+id/btn_launch"
            style="@style/DualSouls.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusedByDefault="true"
            android:text="@string/action_launch" />
    </LinearLayout>

</FrameLayout>
