<?xml version="1.0" encoding="utf-8"?>
<!--
  Every launcher action except PLAY: a dark fill one step above the page, so
  the red PLAY button stays the only bright thing on screen.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#171314" />
            <stroke android:width="1dp" android:color="#2A2326" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4A3F43" />
            <stroke android:width="1dp" android:color="#6A5D62" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2A2326" />
            <stroke android:width="1dp" android:color="#45393E" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
