<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A10"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lab_runtime_banner"
        android:textColor="#FF5252"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_lab_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/txt_lab_generation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B0BEC5" />

    <TextView
        android:id="@+id/txt_lab_features"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B0BEC5" />

    <TextView
        android:id="@+id/txt_lab_lifecycle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/txt_lab_skin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B0BEC5" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_lab_death"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lab_death" />

        <Button
            android:id="@+id/btn_lab_respawn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lab_respawn" />

        <Button
            android:id="@+id/btn_lab_exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lab_exit" />
    </LinearLayout>
</LinearLayout>
