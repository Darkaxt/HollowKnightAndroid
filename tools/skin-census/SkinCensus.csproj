<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dev-only: lists every tk2dSpriteCollectionData in a Silksong depot with its
    material pages and their original atlas dimensions, so the skin catalog
    (docs/superpowers/specs/data/silksong-skin-catalog-v1.txt) and the runtime
    target table can be generated instead of hand-ported. Never shipped.
    Silksong's bundles are type-tree-stripped, so MonoBehaviour fields come from
    the game's Managed assemblies through AssetsTools.NET.MonoCecil.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.2" />
    <PackageReference Include="AssetsTools.NET.MonoCecil" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../bundle-surgery/classdata.tpk" Link="classdata.tpk">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
