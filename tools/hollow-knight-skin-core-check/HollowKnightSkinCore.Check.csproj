<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Keep generated metadata from masking an empty core source list. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../hollow-knight-patches/src/skins/core/**/*.cs" Link="HollowKnightSkins/Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireSkinCoreSources" BeforeTargets="CoreCompile">
    <Error Condition="'@(Compile)' == ''" Text="Hollow Knight skin core source list must not be empty." />
  </Target>
</Project>
