<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ModWeaver</RootNamespace>
    <AssemblyName>ModWeaver</AssemblyName>
    <!--
      The device runs this on the .NET DotnetFetcher stages, the same way it
      runs bundle-surgery and il2cpp: framework-dependent, no apphost.
    -->
    <UseAppHost>false</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Mono.Cecil reads and rewrites IL. It is what MonoMod, ILRepack and Harmony's
    own tooling are built on, and the only one of them that can edit a method
    body with no runtime present. The weaving happens on the device, before
    il2cpp ever sees the assemblies, which is what makes a build-time
    chainloader possible at all.
  -->
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
