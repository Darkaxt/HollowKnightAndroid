<?xml version="1.0" encoding="utf-8"?>
<!--
  Modern launchers may prefer android:roundIcon over android:icon. Keep both
  adaptive so large launcher grids never upscale the legacy 48dp round PNG.
  The unchanged supplied composition remains on the background layer.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_bg" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
