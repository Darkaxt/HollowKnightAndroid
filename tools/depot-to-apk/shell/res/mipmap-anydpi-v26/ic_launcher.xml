<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon, used from Android 8 onwards.

  ic_launcher_bg.png is a resize of the corrected combined image exactly as
  supplied. Its internal elements are not reconstructed or repositioned.
  Android applies the device launcher's circle, squircle, rounded-square, or
  OEM mask to that complete composition.

  The foreground element is required by the adaptive-icon schema and remains
  transparent because the complete composition is carried by the background.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_bg" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
