<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>SharedPatches.Tests</AssemblyName>
    <DefineConstants>HOLLOW_KNIGHT_GAMEPLAY_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="../skin-goldens/v1/launch-descriptors.json" Link="skin-goldens/v1/launch-descriptors.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../skin-goldens/v1/lifecycle.json" Link="skin-goldens/v1/lifecycle.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../skin-goldens/v1/transactions.json" Link="skin-goldens/v1/transactions.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../hollow-knight-patches/src/mods/HollowKnightGameplayFeatures.cs" Link="source-contracts/HollowKnightGameplayFeatures.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../hollow-knight-patches/src/mods/HollowKnightGameTweakApi.cs" Link="source-contracts/HollowKnightGameTweakApi.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../hollow-knight-patches/src/dualsouls/HkStageHooks.cs" Link="source-contracts/HkStageHooks.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../hollow-knight-patches/src/dualsouls/HollowKnightModsPresenter.cs" Link="source-contracts/HollowKnightModsPresenter.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../hollow-knight-patches/src/mods/HollowKnightNativeModsMenu.cs" Link="native-skin-contracts/HollowKnightNativeModsMenu.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../silksong-patches/src/mods/SilksongNativeModsMenu.cs" Link="native-skin-contracts/SilksongNativeModsMenu.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../hollow-knight-patches/src/mods/HollowKnightModsRuntime.cs" Link="native-skin-contracts/HollowKnightModsRuntime.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../silksong-patches/src/mods/SilksongModsRuntime.cs" Link="native-skin-contracts/SilksongModsRuntime.cs" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\shared-patches\src\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../silksong-patches/src/dualscreen/DsPortHudState.cs" Link="Silksong/DsPortHudState.cs" />
    <Compile Include="../silksong-patches/src/dualscreen/DsPortSelectState.cs" Link="Silksong/DsPortSelectState.cs" />
    <Compile Include="../silksong-patches/src/dualscreen/DsPortOverlays.cs" Link="Silksong/DsPortOverlays.cs" />
    <Compile Include="../silksong-patches/src/dualscreen/DsPortJournalState.cs" Link="Silksong/DsPortJournalState.cs" />
    <Compile Include="../silksong-patches/src/dualscreen/DsPortMap.cs" Link="Silksong/DsPortMap.cs" />
    <Compile Include="../silksong-patches/src/dualscreen/DsPortCollectableManager.cs" Link="Silksong/DsPortCollectableManager.cs" />
    <Compile Include="../silksong-patches/src/dualscreen/DsPortFrameState.cs" Link="Silksong/DsPortFrameState.cs" />
    <Compile Include="../hollow-knight-patches/src/skins/core/**/*.cs" Link="HollowKnightSkins/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../hollow-knight-patches/src/skins/runtime/*.cs" Link="HollowKnightSkins/Runtime/%(Filename)%(Extension)" />
    <Compile Include="../silksong-patches/src/skins/runtime/*.cs" Link="SilksongSkins/Runtime/%(Filename)%(Extension)" />
    <Compile Include="..\silksong-patches\src\mods\SilksongTweakAdapter.cs" Link="Silksong\SilksongTweakAdapter.cs" Condition="Exists('..\silksong-patches\src\mods\SilksongTweakAdapter.cs')" />
    <Compile Include="..\silksong-patches\src\mods\SilksongNativeMenuLifecycle.cs" Link="Silksong\SilksongNativeMenuLifecycle.cs" Condition="Exists('..\silksong-patches\src\mods\SilksongNativeMenuLifecycle.cs')" />
    <Compile Include="..\hollow-knight-patches\src\mods\HollowKnightTweakAdapter.cs" Link="HollowKnight\HollowKnightTweakAdapter.cs" Condition="Exists('..\hollow-knight-patches\src\mods\HollowKnightTweakAdapter.cs')" />
    <Compile Include="..\hollow-knight-patches\src\mods\HollowKnightGameTweakApi.cs" Link="HollowKnight\HollowKnightGameTweakApi.cs" Condition="Exists('..\hollow-knight-patches\src\mods\HollowKnightGameTweakApi.cs')" />
    <Compile Include="..\hollow-knight-patches\src\mods\HollowKnightFlashPolicyCore.cs" Link="HollowKnight\HollowKnightFlashPolicyCore.cs" Condition="Exists('..\hollow-knight-patches\src\mods\HollowKnightFlashPolicyCore.cs')" />
    <Compile Include="..\hollow-knight-patches\src\mods\HollowKnightModsSession.cs" Link="HollowKnight\HollowKnightModsSession.cs" Condition="Exists('..\hollow-knight-patches\src\mods\HollowKnightModsSession.cs')" />
  </ItemGroup>
</Project>
