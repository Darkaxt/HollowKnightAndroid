bin/
obj/
*.user
.vs/

# The built APK. Nothing else lands here -- the staging tree and the fetched
# player module live under ~/.cache/silksong, outside the checkout.
/build/

PLAN.md

# Claude Code per-user settings (paths + bash allowlist)
.claude/

# Gradle build intermediates. Per-machine paths; never commit.
src/SilksongLauncher.Launcher/app/build/

# CMake's own working tree for the monojni build. Absolute paths to the NDK,
# regenerated from CMakeLists.txt on any machine that builds.
src/SilksongLauncher.Launcher/app/.cxx/

# The Gradle wrapper Android Studio writes when the project is opened. Nothing
# builds with it: tools/depot-to-apk drives Gradle out of the Unity player
# module (8.11), and the wrapper pins a version that fails to configure this
# project at all. Keeping it out avoids offering a broken second way to build.
src/SilksongLauncher.Launcher/gradle/wrapper/
src/SilksongLauncher.Launcher/gradlew
src/SilksongLauncher.Launcher/gradlew.bat

# adb logcat dumps and pulled device state from a debugging session. Useful
# while a bug is open, meaningless afterwards, and megabytes either way.
logs-*/

# Signing keys. The keystore IS the app's identity on Android: anything signed
# with it is accepted as an update to an existing install, so a leaked one lets
# somebody else ship to every user who has this app. Never in a commit.
*.jks
*.keystore
*.p12

# Python verification helpers are run locally and in CI.
__pycache__/
*.pyc

# Machine-specific paths for the depot-to-apk dev loop, and the signing
# passwords that go with them.
tools/depot-to-apk/dev.env

# Staged into the APK by Gradle from tools/ at build time: the on-device build
# script, bundle-surgery's build output, and the patch sources. Committing them
# would mean two copies of the same file with nothing keeping them in step --
# and a stale one has already shipped in an APK once, which cost an afternoon.
src/SilksongLauncher.Launcher/app/src/main/assets/ondevice/

# Caches the release workflow bind-mounts into the build container: Unity's
# Android player module, NuGet packages, and the keystore it materialises from
# a secret for the length of one build.
/.ci-cache/
